{
	"name": "@phuc-nt-prime/mywb",
	"version": "0.2.0",
	"description": "Headless CLI and MCP server for .mywb whiteboard documents: read and apply record-level changes, scaffold boards from a model, and expose a running My Whiteboard app to coding agents",
	"keywords": [
		"whiteboard",
		"tldraw",
		"mcp",
		"mcp-server",
		"diagram",
		"architecture-diagram",
		"cli",
		"agent"
	],
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://github.com/phuc-nt/my-whiteboard#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phuc-nt/my-whiteboard.git",
		"directory": "apps/cli"
	},
	"bugs": {
		"url": "https://github.com/phuc-nt/my-whiteboard/issues"
	},
	"engines": {
		"node": ">=22.12"
	},
	"bin": {
		"mywb": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"test": "vite build && vitest run",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0"
	},
	"devDependencies": {
		"@mywb/core": "*",
		"@mywb/node-adapter": "*",
		"@types/node": "^25.0.0",
		"@types/react": "^19.0.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tldraw": "5.2.5",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	}
}
